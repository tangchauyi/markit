{
  "name": "markit",
  "productName": "Mark it!",
  "version": "1.0.0",
  "description": "Mark it! — 常驻 macOS 桌面角落的四象限便签看板（plan for it）",
  "author": "markit",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.markit.desktop",
    "productName": "Mark it!",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/AppIcon.icns"
    }
  }
}